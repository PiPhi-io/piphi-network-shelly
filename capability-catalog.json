        "available_updates",
        "available_rpc_methods",
        "component_ids",
        "last_seen_at"
      ],
      "events": [
        "device.discovered",
        "device.online",
        "device.offline",
        "firmware.update_available",
        "profile.changed"
      ],
      "conditions": [
        "device_is_online",
        "firmware_update_is_available",
        "rpc_method_is_available"
      ],
      "actions": [
        "rescan_components"
      ]
    },
    {
