      ],
      "reason": "The scaffold implements configuration lifecycle, connectivity state, refresh dispatch, and a configuration event.",
      "state": [
        "connected"
      ],
      "events": [
        "runtime.config.applied"
      ],
      "conditions": [
        "state_matches"
      ],
      "actions": [
        "refresh"
      ]
    },
    {
      "id": "discovery-system-and-component-negotiation",
      "status": "planned",
      "scope": [
        "shelly-os-devices"
      ],
      "source_refs": [
        "shelly_rpc",
        "shelly_components",
        "shelly_channels"
      ],
      "reason": "mDNS, model/generation discovery, authentication, profiles, firmware, component enumeration, and method ACLs must be negotiated per device.",
      "state": [
        "device_id",
        "device_model",
        "device_generation",
        "device_name",
        "firmware_version",
        "profile",
        "mac_address",
        "uptime_seconds",
