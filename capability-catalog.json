    {
      "id": "transport-health-and-recovery",
      "status": "planned",
      "scope": [
        "http-and-mqtt-configurations"
      ],
      "source_refs": [
        "shelly_rpc",
        "shelly_channels"
      ],
      "reason": "RPC request correlation, digest authentication, notifications, reconnect, rate limits, method errors, and reconciliation need bounded operational telemetry.",
      "state": [
        "rpc_connected",
        "rpc_latency_ms",
        "rpc_error_count",
        "notification_queue_depth",
        "notification_queue_capacity",
        "dropped_notification_count",
        "last_reconciled_at"
      ],
      "events": [
        "rpc.connected",
        "rpc.disconnected",
        "rpc.error",
        "notification_queue.saturated",
        "state.resynchronized"
      ],
      "conditions": [
        "rpc_is_healthy",
        "notification_queue_below",
        "state_is_stale"
      ],
      "actions": [
        "reconnect_rpc",
        "resynchronize_state"
      ]
    },
    {
